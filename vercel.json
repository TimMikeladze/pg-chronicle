{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "cd site && bun install --frozen-lockfile",
	"buildCommand": "cd site && bun run build",
	"outputDirectory": "site/dist",
	"headers": [
		{
			"source": "/og-:hash.png",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
