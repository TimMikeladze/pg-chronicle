# Server
PG_HISTORY_DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
PG_HISTORY_PORT="3001"
PG_HISTORY_POOL_MAX="5"
PG_HISTORY_JWT_SECRET=""

# Tables (comma-separated, used by Next.js entry point)
PG_HISTORY_TABLES="users,orders"

# S3 / Archival
PG_HISTORY_S3_ENDPOINT="http://localhost:9000"
PG_HISTORY_S3_ACCESS_KEY_ID="root"
PG_HISTORY_S3_SECRET_ACCESS_KEY="password"
PG_HISTORY_S3_REGION="us-west-1"
PG_HISTORY_S3_BUCKET="test-bucket"

# Archival tuning
PG_HISTORY_ARCHIVAL_INTERVAL_MS="3600000"
PG_HISTORY_RETENTION_DAYS="90"
PG_HISTORY_GRACE_PERIOD_DAYS="7"
PG_HISTORY_BATCH_SIZE="10000"

# Cron trigger auth (Vercel Cron injects this automatically)
CRON_SECRET=""
