# Server
PG_CHRONICLE_DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
PG_CHRONICLE_PORT="3001"
PG_CHRONICLE_POOL_MAX="5"
PG_CHRONICLE_JWT_SECRET=""

# Tables (comma-separated, used by Next.js entry point)
PG_CHRONICLE_TABLES="users,orders"

# S3 / Archival
PG_CHRONICLE_S3_ENDPOINT="http://localhost:9000"
PG_CHRONICLE_S3_ACCESS_KEY_ID="root"
PG_CHRONICLE_S3_SECRET_ACCESS_KEY="password"
PG_CHRONICLE_S3_REGION="us-west-1"
PG_CHRONICLE_S3_BUCKET="test-bucket"

# Archival tuning
PG_CHRONICLE_ARCHIVAL_INTERVAL_MS="3600000"
PG_CHRONICLE_RETENTION_DAYS="90"
PG_CHRONICLE_GRACE_PERIOD_DAYS="7"
PG_CHRONICLE_BATCH_SIZE="10000"

# Cron trigger auth (Vercel Cron injects this automatically)
CRON_SECRET=""
