# Server
PGHISTORY_DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"
PGHISTORY_PORT="3001"
PGHISTORY_POOL_MAX="5"
PGHISTORY_JWT_SECRET=""

# Tables (comma-separated, used by Next.js entry point)
PGHISTORY_TABLES="users,orders"

# S3 / Archival
PGHISTORY_S3_ENDPOINT="http://localhost:9000"
PGHISTORY_S3_ACCESS_KEY_ID="root"
PGHISTORY_S3_SECRET_ACCESS_KEY="password"
PGHISTORY_S3_REGION="us-west-1"
PGHISTORY_S3_BUCKET="test-bucket"

# Archival tuning
PGHISTORY_ARCHIVAL_INTERVAL_MS="3600000"
PGHISTORY_RETENTION_DAYS="90"
PGHISTORY_GRACE_PERIOD_DAYS="7"
PGHISTORY_BATCH_SIZE="10000"

# Cron trigger auth (Vercel Cron injects this automatically)
CRON_SECRET=""
