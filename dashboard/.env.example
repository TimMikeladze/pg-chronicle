# --- Required -------------------------------------------------------------

# Where the dashboard keeps its own configuration: which databases it manages,
# which tables in each are audited, and whether that connection archives to S3.
#
# Any Postgres will do, including one you already audit — the dashboard creates
# a single table there on first use. This is the ONLY connection string in the
# environment; every audited database is added from the UI.
PG_CHRONICLE_DASHBOARD_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# The dashboard exposes revert, so the API refuses to start without a secret.
# It signs its own short-lived API tokens with this value, and derives the key
# that encrypts stored connection strings and S3 keys from it.
#
# Rotating it invalidates both: every session has to sign in again, and every
# stored credential has to be re-entered from the connection's edit page. The
# UI says exactly that when it happens rather than failing obscurely.
PG_CHRONICLE_JWT_SECRET=change-me-to-a-long-random-string

# Password for the dashboard UI itself.
#
# REQUIRED IN PRODUCTION. The dashboard mints its own API token per request, so
# anyone who can load a page can read every audited record and revert them. In
# production the UI refuses to render until this is set (or the opt-out below
# is). Development works without it.
#
# Make it long and random. Failed logins are delayed and (for identifiable
# clients) locked out for 15 minutes after five tries, but that state is
# per-process — across serverless instances it slows guessing rather than
# stopping it, and the password itself is the real defence.
PG_CHRONICLE_DASHBOARD_PASSWORD=change-me-to-a-long-random-string

# --- Optional -------------------------------------------------------------

# Bearer token for the scheduled archival route, GET /api/cron/archive, which
# runs archival for every connection that has it configured.
#
# Fail-closed: without this the route is disabled entirely. There is no JWT
# alternative — it deletes rows across every managed database, and a browser
# session is not a credential for that.
# CRON_SECRET=another-long-random-string

# Explicitly allow an unauthenticated UI in production. Only correct when an
# access proxy / SSO in front of this deployment authenticates every request.
# PG_CHRONICLE_DASHBOARD_ALLOW_ANONYMOUS=true

# How long a dashboard sign-in lasts. Default: 12
# PG_CHRONICLE_DASHBOARD_SESSION_TTL_HOURS=12

# Written into the JWT `sub`, which pg-chronicle logs as the actor on every
# revert. Set it to something identifiable per deployment. Default: dashboard
# PG_CHRONICLE_DASHBOARD_ACTOR=dashboard

# Must be symmetric (HS256/384/512) — the dashboard both signs and is verified
# against this secret. Default: HS256
# PG_CHRONICLE_JWT_ALG=HS256

# Pool size and statement timeout applied to every managed connection.
# PG_CHRONICLE_POOL_MAX=3
# PG_CHRONICLE_STATEMENT_TIMEOUT_MS=30000
