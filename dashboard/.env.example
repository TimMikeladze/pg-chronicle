# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
PG_HISTORY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Comma-separated tables to audit. This is what enables the history API —
# without it the server starts but serves only /health.
PG_HISTORY_TABLES=users,orders

# The dashboard exposes revert, so the API refuses to start without a secret.
# PG_HISTORY_ALLOW_UNAUTHENTICATED is ignored on this entry point.
# The dashboard signs its own short-lived tokens with this value; it never
# reaches the browser.
PG_HISTORY_JWT_SECRET=change-me-to-a-long-random-string

# Password for the dashboard UI itself.
#
# REQUIRED IN PRODUCTION. The dashboard mints its own API token per request, so
# anyone who can load a page can read every audited record and revert them. In
# production the UI refuses to render until this is set (or the opt-out below
# is). Development works without it.
#
# Make it long and random. Failed logins are delayed and (for identifiable
# clients) locked out for 15 minutes after five tries, but that state is
# per-process — across serverless instances it slows guessing rather than
# stopping it, and the password itself is the real defence.
PG_HISTORY_DASHBOARD_PASSWORD=change-me-to-a-long-random-string

# --- Optional -------------------------------------------------------------

# Explicitly allow an unauthenticated UI in production. Only correct when an
# access proxy / SSO in front of this deployment authenticates every request.
# PG_HISTORY_DASHBOARD_ALLOW_ANONYMOUS=true

# How long a dashboard sign-in lasts. Default: 12
# PG_HISTORY_DASHBOARD_SESSION_TTL_HOURS=12

# Written into the JWT `sub`, which pg-history logs as the actor on every
# revert. Set it to something identifiable per deployment. Default: dashboard
# PG_HISTORY_DASHBOARD_ACTOR=dashboard

# Must be symmetric (HS256/384/512) — the dashboard both signs and is verified
# against this secret. Default: HS256
# PG_HISTORY_JWT_ALG=HS256

# Pool size and statement timeout for the serverless-friendly pool.
# PG_HISTORY_POOL_MAX=3
# PG_HISTORY_STATEMENT_TIMEOUT_MS=30000

# --- Archiver (optional) --------------------------------------------------
# Setting PG_HISTORY_S3_BUCKET registers /api/stats, /api/health/detailed and
# /api/archive, and turns on the archival panels in the dashboard.

# PG_HISTORY_S3_BUCKET=my-audit-archive
# PG_HISTORY_S3_ENDPOINT=http://localhost:9000
# PG_HISTORY_S3_REGION=us-east-1
# PG_HISTORY_S3_ACCESS_KEY_ID=root
# PG_HISTORY_S3_SECRET_ACCESS_KEY=password
# PG_HISTORY_RETENTION_DAYS=90
# PG_HISTORY_GRACE_PERIOD_DAYS=7
# PG_HISTORY_BATCH_SIZE=10000

# Cron bearer token for POST /api/archive. The secret and a JWT are accepted
# as ALTERNATIVE credentials on that route, so setting this lets a scheduler in
# without locking the dashboard's "Run archival" button out.
# CRON_SECRET=another-long-random-string
