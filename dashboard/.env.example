# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
PGHISTORY_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Comma-separated tables to audit. This is what enables the history API —
# without it the server starts but serves only /health.
PGHISTORY_TABLES=users,orders

# The dashboard exposes revert, so the API refuses to start without a secret.
# PGHISTORY_ALLOW_UNAUTHENTICATED is ignored on this entry point.
# The dashboard signs its own short-lived tokens with this value; it never
# reaches the browser.
PGHISTORY_JWT_SECRET=change-me-to-a-long-random-string

# --- Optional -------------------------------------------------------------

# Written into the JWT `sub`, which pghistory logs as the actor on every
# revert. Set it to something identifiable per deployment. Default: dashboard
# PGHISTORY_DASHBOARD_ACTOR=dashboard

# Must be symmetric (HS256/384/512) — the dashboard both signs and is verified
# against this secret. Default: HS256
# PGHISTORY_JWT_ALG=HS256

# Pool size and statement timeout for the serverless-friendly pool.
# PGHISTORY_POOL_MAX=3
# PGHISTORY_STATEMENT_TIMEOUT_MS=30000

# --- Archiver (optional) --------------------------------------------------
# Setting PGHISTORY_S3_BUCKET registers /api/stats, /api/health/detailed and
# /api/archive, and turns on the archival panels in the dashboard.

# PGHISTORY_S3_BUCKET=my-audit-archive
# PGHISTORY_S3_ENDPOINT=http://localhost:9000
# PGHISTORY_S3_REGION=us-east-1
# PGHISTORY_S3_ACCESS_KEY_ID=root
# PGHISTORY_S3_SECRET_ACCESS_KEY=password
# PGHISTORY_RETENTION_DAYS=90
# PGHISTORY_GRACE_PERIOD_DAYS=7
# PGHISTORY_BATCH_SIZE=10000

# Cron bearer token for POST /api/archive.
#
# NOTE: setting this makes the dashboard's "Run archival" button unavailable.
# /api/archive then requires the Authorization header to be exactly
# `Bearer <CRON_SECRET>`, but the /api/* JWT middleware rejects anything that
# is not a valid token first — one header cannot satisfy both. Leave it unset
# to trigger archival from the UI; set it when a scheduler owns archival.
# CRON_SECRET=another-long-random-string
