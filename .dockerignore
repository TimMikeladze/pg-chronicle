# flyctl launch added from docs/.gitignore
# deps
docs/node_modules

# generated content
docs/**/.source

# test & build
docs/coverage
docs/.next
docs/out
docs/build
docs/**/*.tsbuildinfo

# misc
docs/**/.DS_Store
docs/**/*.pem
docs/.pnp
docs/**/.pnp.js
docs/**/npm-debug.log*
docs/**/yarn-debug.log*
docs/**/yarn-error.log*

# others
docs/**/.env*.local
docs/**/.vercel
docs/**/next-env.d.ts

# Exclude test files and docs from Docker build
test
docs
*.md
!README.md
.git
.github
fly.toml
archiver.config.json
